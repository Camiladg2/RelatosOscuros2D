  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Relatos Oscuros\nUN VIDEOJUEGO CREADO POR\nAlejandra Restrepo & Camila
    Dulce\n\nDISE\xD1O DE ARTE, AMBIENTACI\xD3N Y UI\nCamila\nDise\xF1o de Interfaces
    (UI/UX) y Men\xFAs\nDise\xF1o de Escenarios y Tilesets (La Patasola, La Llorona,
    La Madremonte)\nCuradur\xEDa de Audio y Atm\xF3sfera Sonora\n\nARTE DE PERSONAJES
    Y ANIMACI\xD3N\nAlejandra\nIlustraci\xF3n Vectorial 2D\nDise\xF1o y Animaci\xF3n
    de Protagonista, Entes y Criaturas\nDise\xF1o de Pociones y Coleccionables\n\nPROGRAMACI\xD3N
    Y DESARROLLO T\xC9CNICO\nCamila\nInteligencia Artificial de Enemigos y Entes\nSistemas
    de Interfaz (UI), Pausa y Flujo de Pantallas\nConfiguraci\xF3n de C\xE1maras
    (Cinemachine) e Iluminaci\xF3n Final\n\nAlejandra\nMec\xE1nicas del Jugador,
    Combate y Power-Ups\nSistema de Progreso, Portales y Puntos de Control\nEfectos
    Visuales (VFX) y Clima\n\nTECNOLOG\xCDA Y RECURSOS\nDesarrollado en Unity 2D\nInspirado
    en las leyendas del folclor colombiano\n\nProyecto Acad\xE9mico \u2014 Noviembre
    2026"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
